MODEL=qwen3.8-flash
BASE_URL=https://ai.leihuo.netease.com/v1
API_KEY=
MAX_OUTPUT_TOKENS=8192
# default 使用服务端默认值；支持该参数的模型可显式设置 enabled 或 disabled。
THINKING_MODE=default
COMPACT_THINKING_MODE=disabled
REASONING_EFFORT=
# 按实际网关支持的容量设置；默认使用保守预算。
CONTEXT_WINDOW_TOKENS=131072
BATCH_SECONDS=30
REQUEST_TIMEOUT_SECONDS=240
MAX_TURNS_PER_BATCH=30
MAX_REQUEST_BYTES=25165824
# 视频片段的编码参数；片段无音轨，对白仍来自字幕/ASR。
VIDEO_LONG_EDGE=640
VIDEO_FPS=3
VIDEO_CRF=30
VIDEO_MAX_BYTES=8388608
MAX_VIDEO_SECONDS=30
MAX_VIDEOS=3
VIDEO_ANALYSIS__ASR_API_KEY=
VIDEO_ANALYSIS__ASR_RESOURCE_ID=volc.bigasr.auc
VIDEO_ANALYSIS__ASR_TIMEOUT_SECONDS=900
ASR_SEGMENT_SECONDS=300
ASR_POLL_INTERVAL_SECONDS=2
OSS__ENDPOINT=
OSS__BUCKET=
OSS__ACCESS_KEY_ID=
OSS__ACCESS_KEY_SECRET=
