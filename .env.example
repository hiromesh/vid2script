MODEL=deepseek-v4-flash
BASE_URL=https://api.deepseek.com/v1
API_KEY=
MAX_OUTPUT_TOKENS=8192
# default 使用服务端默认值；DeepSeek 可显式设置 enabled 或 disabled。
THINKING_MODE=default
COMPACT_THINKING_MODE=disabled
REASONING_EFFORT=
# 按实际网关支持的容量设置；默认使用保守预算。
CONTEXT_WINDOW_TOKENS=131072
BATCH_SECONDS=30
MAX_REQUEST_BYTES=25165824
MAX_IMAGES=32
IMAGE_LONG_EDGE=1280
IMAGE_TOKEN_BUDGET=2048
VIDEO_ANALYSIS__ASR_API_KEY=
VIDEO_ANALYSIS__ASR_RESOURCE_ID=volc.bigasr.auc
VIDEO_ANALYSIS__ASR_TIMEOUT_SECONDS=900
ASR_SEGMENT_SECONDS=300
OSS__ENDPOINT=
OSS__BUCKET=
OSS__ACCESS_KEY_ID=
OSS__ACCESS_KEY_SECRET=
